// Equivalent of Snakemake's config.yaml + `--use-conda`

params {
    counts_url = 'https://raw.githubusercontent.com/hbc/NGS_Data_Analysis_Course/master/sessionIII/data/Mov10_full_counts.txt'
    outdir  = 'results'
}

process {
    conda = "${projectDir}/conf/environment.yml"
}

profiles {
    conda {
        conda.enabled = true
    }
    docker {
        docker.enabled = true
        process.container = 'rocker/r-ver:4.3.1'
    }
    slurm {
        process.executor = 'slurm'
        process.queue    = 'short'
    }
}

report.overwrite  = true
timeline.overwrite = true
dag.overwrite      = true
